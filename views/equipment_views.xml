<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_it_equipment_tree" model="ir.ui.view">
        <field name="name">it.equipment.tree</field>
        <field name="model">it.equipment</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="state == 'disponible'"
                decoration-warning="state == 'prete'"
                decoration-danger="state == 'en_panne'">

                <field name="name"/>
                <field name="equipment_type"/>
                <field name="serial_number"/>
                <field name="state"/>
                <field name="purchase_date"/>

            </tree>
        </field>
    </record>

    <record id="view_it_equipment_form" model="ir.ui.view">
        <field name="name">it.equipment.form</field>
        <field name="model">it.equipment</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button
                        name="action_mark_loaned"
                        string="Marquer comme prêté"
                        type="object"
                        class="btn-primary"/>

                    <button
                        name="action_mark_returned"
                        string="Marquer comme retourné"
                        type="object"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="equipment_type"/>
                        <field name="serial_number"/>
                        <field name="state"/>
                        <field name="purchase_date"/>
                        <field name="days_since_purchase" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_it_equipment" model="ir.actions.act_window">
        <field name="name">IT Equipment</field>
        <field name="res_model">it.equipment</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="view_it_equipment_kanban" model="ir.ui.view">
        <field name="name">it.equipment.kanban</field>
        <field name="model">it.equipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">

                <field name="name"/>
                <field name="equipment_type"/>
                <field name="state"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <strong>
                                <field name="name"/>
                            </strong>

                            <div>
                                <field name="equipment_type"/>
                            </div>

                            <div>
                                <field name="state"/>
                            </div>
                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <record id="view_it_equipment_search" model="ir.ui.view">
        <field name="name">it.equipment.search</field>
        <field name="model">it.equipment</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>

                <filter
                    string="Disponible"
                    name="available"
                    domain="[('state','=','disponible')]"/>

                <filter
                    string="En panne"
                    name="broken"
                    domain="[('state','=','en_panne')]"/>

                <group expand="0" string="Group By">
                    <filter
                        string="Type"
                        name="group_type"
                        context="{'group_by':'equipment_type'}"/>
                </group>

            </search>
        </field>
    </record>
</odoo>