<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_it_loan_tree" model="ir.ui.view">
        <field name="name">it.loan.tree</field>
        <field name="model">it.loan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="equipment_id"/>
                <field name="employee_id"/>
                <field name="loan_date"/>
                <field name="return_date"/>
            </tree>
        </field>
    </record>

    <record id="view_it_loan_form" model="ir.ui.view">
        <field name="name">it.loan.form</field>
        <field name="model">it.loan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="equipment_id"/>
                        <field name="employee_id"/>
                        <field name="loan_date"/>
                        <field name="return_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">it.loan</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>